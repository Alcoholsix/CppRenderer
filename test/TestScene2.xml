<?xml version="1.0" encoding="UTF-8"?>

<!-- 康奈尔盒测试场景 -->
<!-- 第一行必须为 XML 声明，不能有空行、注释等 -->

<Scene>
    <Camera>
        <Position x="0" y="0" z="0"/>
        <Target x="0" y="0" z="1"/>
        <Up x="0" y="1" z="0"/>
        <FOV value="50"/>
        <Near value="0.1"/>
        <Far value="1000"/>
    </Camera>

    <Objects>
        <!-- 后墙 -->
        <Object type="Triangle">
            <Transform>
                <Position x="0" y="0" z="0"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <VertexA x="-2" y="-2" z="7"/>
            <VertexB x="2" y="-2" z="7"/>
            <VertexC x="2" y="2" z="7"/>
        </Object>

        <Object type="Triangle">
            <Transform>
                <Position x="0" y="0" z="0"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <VertexA x="-2" y="-2" z="7"/>
            <VertexB x="2" y="2" z="7"/>
            <VertexC x="-2" y="2" z="7"/>
        </Object>

        <!-- 地板 -->
        <Object type="Triangle">
            <Transform>
                <Position x="0" y="0" z="0"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <VertexA x="-2" y="-2" z="3"/>
            <VertexB x="2" y="-2" z="3"/>
            <VertexC x="2" y="-2" z="7"/>
        </Object>

        <Object type="Triangle">
            <Transform>
                <Position x="0" y="0" z="0"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <VertexA x="-2" y="-2" z="3"/>
            <VertexB x="2" y="-2" z="7"/>
            <VertexC x="-2" y="-2" z="7"/>
        </Object>

        <!-- 天花板 -->
        <Object type="Triangle">
            <Transform>
                <Position x="0" y="0" z="0"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <VertexA x="-2" y="2" z="3"/>
            <VertexB x="2" y="2" z="7"/>
            <VertexC x="2" y="2" z="3"/>
        </Object>

        <Object type="Triangle">
            <Transform>
                <Position x="0" y="0" z="0"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <VertexA x="-2" y="2" z="3"/>
            <VertexB x="-2" y="2" z="7"/>
            <VertexC x="2" y="2" z="7"/>
        </Object>

        <!-- 左墙 -->
        <Object type="Triangle">
            <Transform>
                <Position x="0" y="0" z="0"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <VertexA x="-2" y="-2" z="3"/>
            <VertexB x="-2" y="-2" z="7"/>
            <VertexC x="-2" y="2" z="7"/>
        </Object>

        <Object type="Triangle">
            <Transform>
                <Position x="0" y="0" z="0"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <VertexA x="-2" y="-2" z="3"/>
            <VertexB x="-2" y="2" z="7"/>
            <VertexC x="-2" y="2" z="3"/>
        </Object>

        <!-- 右墙 -->
        <Object type="Triangle">
            <Transform>
                <Position x="0" y="0" z="0"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <VertexA x="2" y="-2" z="3"/>
            <VertexB x="2" y="2" z="7"/>
            <VertexC x="2" y="-2" z="7"/>
        </Object>

        <Object type="Triangle">
            <Transform>
                <Position x="0" y="0" z="0"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <VertexA x="2" y="-2" z="3"/>
            <VertexB x="2" y="2" z="3"/>
            <VertexC x="2" y="2" z="7"/>
        </Object>

        <!-- 左侧测试球 -->
        <Object type="Sphere">
            <Transform>
                <Position x="-0.8" y="-1.2" z="4.5"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <Radius value="0.8"/>
        </Object>

        <!-- 右侧测试球 -->
        <Object type="Sphere">
            <Transform>
                <Position x="0.9" y="-1.3" z="5.5"/>
                <Rotation x="0" y="0" z="0"/>
                <Scale value="1"/>
            </Transform>
            <Radius value="0.7"/>
        </Object>
    </Objects>
</Scene>